{
  "appId": "org.babada.reshethachaim.hagadol",
  "productName": "רשת החיים – המסע הגדול",
  "executableName": "reshet-hachaim-hamasa-hagadol",
  "directories": {
    "output": "release-1.4",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "report-pdf.js",
    "app/**/*",
    "!app/build-info.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon-hagadol.ico",
    "signExecutable": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "רשת החיים – המסע הגדול",
    "uninstallDisplayName": "רשת החיים – המסע הגדול",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "artifactName": "reshet-hachaim-hagadol-setup-${version}.exe",
    "installerIcon": "build/icon-hagadol.ico",
    "uninstallerIcon": "build/icon-hagadol.ico"
  },
  "publish": null,
  "extraMetadata": {
    "name": "reshet-hachaim-hagadol",
    "productName": "רשת החיים – המסע הגדול",
    "dataName": "רשת החיים – המסע הגדול",
    "carryFrom": [
      "רשת החיים – מהדורה תורנית",
      "רשת החיים"
    ]
  },
  "mac": {
    "target": [
      {
        "target": "zip",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "icon": "build/icon-hagadol-mac.png",
    "category": "public.app-category.education",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "artifactName": "reshet-hachaim-hagadol-mac-${arch}-${version}.${ext}",
    "minimumSystemVersion": "11.0"
  }
}